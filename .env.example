# ---------- LLM ----------
# OpenRouter (OpenAI-compatible) — DeepSeek V3 free tier
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-chat
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ---------- Observability ----------
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=hitl-support-agent
LANGSMITH_TRACING=true
# Region: leave unset for US; set to https://eu.api.smith.langchain.com for EU accounts
LANGSMITH_ENDPOINT=

# ---------- Enterprise email (Tencent default; NetEase alternative) ----------
# New setup uses EMAIL_* names. The client authorization code is not the
# mailbox login password.
EMAIL_PROVIDER=tencent
EMAIL_USER=support@yourcompany.com
EMAIL_APP_PASSWORD=
# Tencent: imap.exmail.qq.com / smtp.exmail.qq.com
# NetEase: imaphz.qiye.163.com / smtphz.qiye.163.com
EMAIL_IMAP_HOST=imap.exmail.qq.com
EMAIL_IMAP_PORT=993
EMAIL_SMTP_HOST=smtp.exmail.qq.com
EMAIL_SMTP_PORT=465
# Empty = infer ssl for 465 and starttls for 587.
EMAIL_SMTP_SECURITY=

# ---------- Feishu test enterprise approval channel ----------
APPROVAL_PROVIDER=feishu
# Create a self-built app in the Feishu test enterprise and enable the bot.
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_RECEIVE_ID_TYPE=chat_id
# Test chat ID, usually starts with oc_. One chat can serve all three routes.
FEISHU_RECEIVE_ID=
# Copy from the app's event subscription / callback security settings.
FEISHU_VERIFICATION_TOKEN=
# Leave empty for the first local plaintext callback test.
FEISHU_ENCRYPT_KEY=
FEISHU_API_BASE_URL=https://open.feishu.cn/open-apis

# Optional per-intent Feishu chat IDs. Empty values fall back to FEISHU_RECEIVE_ID.
FEISHU_CHAT_REFUNDS=
FEISHU_CHAT_TECHNICAL=
FEISHU_CHAT_COMPLAINTS=

# ---------- Legacy Slack fallback (optional) ----------
# Set APPROVAL_PROVIDER=slack only if you need the old Slack adapter.
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_APP_TOKEN=
# Old GMAIL_* and SLACK_CHANNEL_* names are still accepted for compatibility.

# ---------- Persistence ----------
SQLITE_CHECKPOINT_PATH=./data/checkpoints.sqlite

# ---------- PII vault (durable execution) ----------
# Empty (default) → vault lives only in process memory, matching the
# C1/C2 audit hardening from 2026-05-09 (real recipient + token-map
# never on disk, never to LangSmith).
# Non-empty → SQLite sidecar persists envelope_from + token_map so a
# ticket paused at the Interrupt Gate can resume after process death.
# Required for the "kill mid-interrupt + resume" durable-execution demo.
# Trade-off: PII at rest in plaintext SQLite. Mitigate with disk
# encryption / restricted file ACL. See docs/threat_model.md A1.
PII_VAULT_DB_PATH=

# ---------- Tunables (defaults match CLAUDE.md) ----------
REVALIDATE_THRESHOLD_MIN=15
MAX_HUMAN_REJECTIONS=3
MAX_SEND_RETRIES=3
SLA_DEADLINE_HOURS=24
IMAP_POLL_INTERVAL_SEC=30

# ---------- Server ----------
# Code default is 127.0.0.1 (loopback only) — bandit B104 safer default for
# dev. The line below is commented intentionally: if you copy this file
# verbatim you stay on the safe loopback bind. Uncomment ONLY when you need
# to accept external traffic (Docker / container / cloud deploy).
# Docker Compose already sets HOST=0.0.0.0 via its own `environment:` block
# and binds the host port via `127.0.0.1:8000:8000` so the container's
# 0.0.0.0 bind never reaches the host network.
# See docs/threat_model.md row A5 for the full rationale.
# HOST=0.0.0.0
PORT=8000

# ---------- v4 multi-agent (Researcher + Drafter ↔ Critic) ----------
# 0 = v3 single-agent. 1 = v4 multi-agent (default). See docs/v4_multiagent.md.
# Default flipped to v4 on 2026-05-23 — bitext27 + adversarial evals show v4
# catches 5/6 dangerous false auto-sends v3 missed (invoice queries, order
# tracking, etc.) and 3 more classifier-trap cases on the red-team set.
# Trade-off documented in eval/bitext27_findings.md: v4 costs ~2× per ticket
# and over-escalates some simple FAQs. Set =0 to recover the v3 single-agent
# baseline for direct comparison.
MULTIAGENT_ENABLED=1
# Per-agent model overrides for A/B experiments — leave blank to use OPENROUTER_MODEL.
RESEARCHER_MODEL_OVERRIDE=
DRAFTER_MODEL_OVERRIDE=
CRITIC_MODEL_OVERRIDE=
